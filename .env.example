# ===============================================
# OmniCache AI Proxy - Production Environment
# ===============================================

# Server Networking
OMNICACHE_PORT=8000
OMNICACHE_HOST=0.0.0.0

# Upstream Provider Base URLs
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# Cache Configuration
SIMILARITY_THRESHOLD=0.92
EXACT_CACHE_TTL=604800
SEMANTIC_CACHE_TTL=604800
MAX_CACHE_ENTRIES=10000

# Persistence & Storage
OMNICACHE_DB_PATH=/root/omnicache_proxy/omnicache.db

# Streaming Velocity (tokens per second)
STREAM_REPLAY_TOKENS_PER_SEC=65.0
