# ===============================================
# OmniCache AI Proxy - Production Environment
# ===============================================

# Server Networking (Default to loopback for security; use 0.0.0.0 only with REQUIRE_AUTH=true)
OMNICACHE_PORT=8000
OMNICACHE_HOST=127.0.0.1

# Master Admin Key & Authentication (Required for production / public-facing deployments)
REQUIRE_AUTH=true
ADMIN_API_KEY=your-master-admin-key-change-me

# Cryptographic Salt for PII Redaction Tokenization (Leave blank for auto-generated 256-bit salt)
# PRIVACY_SALT=your-unique-cryptographic-salt-hex

# Restricted CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:3000

# Upstream Provider Base URLs
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# Cache Configuration
SIMILARITY_THRESHOLD=0.92
EXACT_CACHE_TTL=604800
SEMANTIC_CACHE_TTL=604800
MAX_CACHE_ENTRIES=10000

# Distributed State & Clustering (Set REDIS_URL to enable horizontal multi-worker scaling)
# REDIS_URL=redis://127.0.0.1:6379/0
# CACHE_STORAGE_BACKEND=auto

# Persistence & Storage
OMNICACHE_DB_PATH=/root/omnicache_proxy/omnicache.db

# Streaming Velocity (tokens per second)
STREAM_REPLAY_TOKENS_PER_SEC=65.0
