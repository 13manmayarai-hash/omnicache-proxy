[Unit]
Description=OmniCache AI Proxy Daemon
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/omnicache_proxy
ExecStart=/usr/bin/python3 /root/omnicache_proxy/main.py
Restart=always
RestartSec=3
Environment="OMNICACHE_PORT=8000"
Environment="OMNICACHE_HOST=0.0.0.0"
Environment="OMNICACHE_DB_PATH=/root/omnicache_proxy/omnicache.db"

# Security sandboxing
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
